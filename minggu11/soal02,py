def rata():
    total = 0
    jumlah = 0
    
    while True:
        masuk = input("Masukkan angka (ketik 'done'): ")
        
        if masuk == "done":
            break
        
        total += int(masuk)
        jumlah += 1
    
    return total / jumlah if jumlah > 0 else 0

print("Rata-rata:", rata())